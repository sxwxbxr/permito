{
  "name": "@permitojs/core",
  "version": "0.5.0",
  "description": "Privacy-first, framework-agnostic consent engine. No network calls, no tracking.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/permito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxwxbxr/permito.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sxwxbxr/permito/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/permito.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./permito.global.js": "./dist/permito.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "consent",
    "cookie-consent",
    "gdpr",
    "dsg",
    "privacy",
    "consent-mode"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "jsdelivr": "./dist/permito.global.js",
  "unpkg": "./dist/permito.global.js"
}
